{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RCleaner",
  "identifier": "com.rcleaner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RCleaner",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0b0c10",
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Modular cleaner and maintenance tool for Windows",
    "longDescription": "RCleaner cleans temporary files, browser caches, developer caches and AI models, with per-profile modes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCNzkxNzZFQ0RGOEM2OEUKUldTT3h2ak5iaGQ1U3pic0EvK0d3THpkVkw0azRCSGdaYjdKTjNJK09XekZob2gwTU1XUEZ5QncK",
      "endpoints": [
        "https://github.com/CristopherPaiz/RCleaner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
