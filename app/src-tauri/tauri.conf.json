{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RCleaner",
  "identifier": "com.rcleaner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RCleaner",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0b0c10",
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Utility",
    "shortDescription": "Limpiador y mantenimiento modular para Windows",
    "longDescription": "RCleaner limpia temporales, cachés de navegadores, cachés de desarrollo y modelos de IA con modos por perfil.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "es-ES" },
      "nsis": { "languages": ["Spanish"], "displayLanguageSelector": false }
    }
  }
}
